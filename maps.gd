extends RefCounted
# Mapas: casa (aleatória a cada partida), banco, hospital, mercado.

const T := 14.0


func _w(hz: bool, c: float, u: float, v: float) -> Array:
	if hz:
		return [u, c - T / 2.0, v - u, T]
	return [c - T / 2.0, u, T, v - u]


func _seg(out: Array, hz: bool, c: float, a: float, b: float, gaps: Array) -> void:
	var p := a
	for g in gaps:
		if float(g[0]) > p:
			out.append(_w(hz, c, p, float(g[0])))
		p = float(g[0]) + float(g[1])
	if b > p:
		out.append(_w(hz, c, p, b))


func _outer(w: float, h: float, left_gaps: Array) -> Array:
	var out: Array = []
	out.append([0.0, 0.0, w, T])
	out.append([0.0, h - T, w, T])
	out.append([w - T, 0.0, T, h])
	_seg(out, false, T / 2.0, 0.0, h, left_gaps)
	return out


func get_map(id: String) -> Dictionary:
	if id == "banco":
		return _banco()
	if id == "hospital":
		return _hospital()
	if id == "mercado":
		return _mercado()
	return _casa()


func _flip(m: Dictionary) -> void:
	var h: float = m["h"]
	for r in m["walls"]:
		r[1] = h - r[1] - r[3]
	for r in m["props"]:
		r[1] = h - r[1] - r[3]
	for r in m["rooms"]:
		r[1] = h - r[1] - r[3]
	for key in ["sleepers", "spawns"]:
		for p in m[key]:
			p[1] = h - p[1]
	m["start"][1] = h - m["start"][1]
	m["entry"][1] = h - m["entry"][1]


